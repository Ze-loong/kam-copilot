# DeepSeek API Key，用于 src/llm/llm_setting.py 初始化 LLM
DEEPSEEK_API_KEY=<请填自己的DeepSeek API Key>

# PostgreSQL 连接串，用于 src/webapp/webapp.py 的 checkpoint 存储
# 本地默认格式: postgresql://用户名:密码@127.0.0.1:5432/数据库名
KAM_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5442/postgres?connect_timeout=3

# pgvector 资料库连接串
KAM_VECTOR_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5443/postgres?connect_timeout=3

# kam_agent 与后台/侧边栏之间的内部调用密钥，各组件必须一致
INTERNAL_API_KEY=<请生成随机长字符串>
